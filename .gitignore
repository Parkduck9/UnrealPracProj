# Unreal Engine generated files and build products

# IDE and user-specific files
.vs/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Generated project/workspace files
*.sln
*.xcodeproj
*.xcworkspace

# Compiled object files
*.slo
*.lo
*.o
*.obj

# Precompiled headers
*.gch
*.pch

# Dynamic libraries
*.so
*.dylib
*.dll

# Static libraries
*.lai
*.la
*.a
*.lib

# Executables and packaged applications
*.exe
*.out
*.app
*.ipa

# Fortran module files
*.mod

# Unreal Engine generated directories
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/

# Generated directories inside plugins
Plugins/**/Binaries/
Plugins/**/DerivedDataCache/
Plugins/**/Intermediate/
Plugins/**/Saved/

# Allow build metadata that must remain under version control
!Build/
!Build/**/
!Build/**/PakBlacklist*.txt
!Build/**/*.ico

# Map lighting/build data can be regenerated
*_BuiltData.uasset

# Optional source-art exports
SourceArt/**/*.png
SourceArt/**/*.tga

# Local logs and crash dumps
*.log
*.dmp

# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini

# .NET build output (WebServer/)
bin/
obj/
